# Mock Bridge dev server (`npm run dev`)
# Copy to .env and fill in the values: cp .env.example .env

# Required: URL of the embedded app to load inside the mock admin iframe
SHOPIFY_APP_URL=http://localhost:3000

# Optional: app credentials used to sign mock session tokens.
# Defaults to the standard mock client id/secret when empty.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional: shop domain (default: test-shop.myshopify.com)
SHOPIFY_SHOP=test-shop.myshopify.com

# Optional: port for the mock admin server (default: 3080).
# Also used by admin-frame/vite.config.ts to proxy API calls.
SHOPIFY_PORT=3080

# Optional: verbose server logging (default: false)
SHOPIFY_DEBUG=false

# Optional: user id put in the mock session token `sub` claim (default: 123456789)
MOCK_USER_ID=

# Optional, live shop mode: offline Admin API token (shpat_…) of an app installed
# on SHOPIFY_SHOP. Admin API calls then hit the real store instead of mock data.
# Never commit a real token.
MOCK_BRIDGE_ADMIN_ACCESS_TOKEN=
